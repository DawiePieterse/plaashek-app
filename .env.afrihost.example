# Copy to ".env" in the farm's folder on Afrihost (e.g. plaashek-bekfontein/, next to app/ and public/) and
# fill in the blanks. Database details: cPanel > Database Wizard (names start with the account prefix).
# APP_KEY: run `php artisan key:generate --show` and paste it. Keep a copy in the owner's password manager:
# without it, encrypted columns in a restored backup cannot be read.

APP_NAME=Plaashek
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://bekfontein.plaashek.co.za
APP_TIMEZONE=Africa/Johannesburg
APP_LOCALE=af
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log

PLAASHEK_STAFF_EMAIL=staff@plaashek.co.za
# Blank: Open-Meteo's free API, while Plaashek is in development and marketing. A key once farms pay.
OPEN_METEO_API_KEY=
